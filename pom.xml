                </dependencies>
            </plugin>
            <!-- 配置项 plugin：说明该配置的用途、默认值或运行影响。 -->
            <plugin>
                <!-- 配置项 groupId：说明该配置的用途、默认值或运行影响。 -->
                <groupId>org.apache.maven.plugins</groupId>
                <!-- 配置项 artifactId：说明该配置的用途、默认值或运行影响。 -->
                <artifactId>maven-checkstyle-plugin</artifactId>
                <!-- 配置项 version：说明该配置的用途、默认值或运行影响。 -->
                <version>${maven.checkstyle.plugin.version}</version>
                <!-- 配置项 configuration：说明该配置的用途、默认值或运行影响。 -->
                <configuration>
                    <!-- 配置项 configLocation：说明该配置的用途、默认值或运行影响。 -->
                    <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                    <!-- 配置项 includeTestSourceDirectory：说明该配置的用途、默认值或运行影响。 -->
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <!-- 配置项 consoleOutput：说明该配置的用途、默认值或运行影响。 -->
                    <consoleOutput>true</consoleOutput>
                    <!-- 配置项 failsOnError：说明该配置的用途、默认值或运行影响。 -->
                    <failsOnError>true</failsOnError>
                    <!-- 配置项 linkXRef：说明该配置的用途、默认值或运行影响。 -->
                    <linkXRef>false</linkXRef>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
