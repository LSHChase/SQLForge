<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 配置项 mapper：说明该配置的用途、默认值或运行影响。 -->
<mapper namespace="com.company.governance.infrastructure.persistence.mapper.DispatchPolicyMapper">

    <!-- 配置项 resultMap id=DispatchPolicyResultMap：说明该配置的用途、默认值或运行影响。 -->
    <resultMap id="DispatchPolicyResultMap" type="com.company.governance.infrastructure.persistence.entity.DispatchPolicyRecord">
        <!-- 配置项 id：说明该配置的用途、默认值或运行影响。 -->
        <id property="policyId" column="policy_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="tenantId" column="tenant_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="policyName" column="policy_name"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="dispatchType" column="dispatch_type"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="targetEngine" column="target_engine"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="targetDatasource" column="target_datasource"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="ackMode" column="ack_mode"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="pullWindowSeconds" column="pull_window_seconds"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="maxBatchSize" column="max_batch_size"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="retryStrategy" column="retry_strategy"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="enabled" column="enabled"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createTime" column="create_time"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 配置项 sql id=BaseColumns：说明该配置的用途、默认值或运行影响。 -->
    <sql id="BaseColumns">
        policy_id,
        tenant_id,
        policy_name,
        dispatch_type,
        target_engine,
        target_datasource,
        ack_mode,
        pull_window_seconds,
        max_batch_size,
        retry_strategy,
        enabled,
        create_time,
        update_time
    </sql>

    <!-- 配置项 insert id=upsert：说明该配置的用途、默认值或运行影响。 -->
    <insert id="upsert" parameterType="com.company.governance.infrastructure.persistence.entity.DispatchPolicyRecord">
        INSERT INTO dispatch_policy (
            policy_id,
            tenant_id,
            policy_name,
            dispatch_type,
            target_engine,
            target_datasource,
            ack_mode,
            pull_window_seconds,
            max_batch_size,
            retry_strategy,
            enabled,
            create_time,
            update_time
        ) VALUES (
            #{policyId},
            #{tenantId},
            #{policyName},
            #{dispatchType},
            #{targetEngine},
            #{targetDatasource},
            #{ackMode},
            #{pullWindowSeconds},
            #{maxBatchSize},
            #{retryStrategy},
            #{enabled},
            #{createTime},
            #{updateTime}
        )
        ON DUPLICATE KEY UPDATE
            policy_name = VALUES(policy_name),
            dispatch_type = VALUES(dispatch_type),
            target_engine = VALUES(target_engine),
            target_datasource = VALUES(target_datasource),
            ack_mode = VALUES(ack_mode),
            pull_window_seconds = VALUES(pull_window_seconds),
            max_batch_size = VALUES(max_batch_size),
            retry_strategy = VALUES(retry_strategy),
            enabled = VALUES(enabled),
            update_time = VALUES(update_time)
    </insert>

    <!-- 配置项 select id=selectByTenantId：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectByTenantId" resultMap="DispatchPolicyResultMap">
        SELECT
        <!-- 配置项 include：说明该配置的用途、默认值或运行影响。 -->
        <include refid="BaseColumns"/>
        FROM dispatch_policy
        WHERE tenant_id = #{tenantId}
        ORDER BY policy_name ASC, update_time DESC
    </select>
</mapper>
