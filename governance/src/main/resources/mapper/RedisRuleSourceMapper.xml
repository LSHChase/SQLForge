<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 配置项 mapper：说明该配置的用途、默认值或运行影响。 -->
<mapper namespace="com.company.governance.infrastructure.persistence.mapper.RedisRuleSourceMapper">

    <!-- 配置项 resultMap id=RedisRuleSourceResultMap：说明该配置的用途、默认值或运行影响。 -->
    <resultMap id="RedisRuleSourceResultMap" type="com.company.governance.infrastructure.persistence.entity.RedisRuleSourceRecord">
        <!-- 配置项 id：说明该配置的用途、默认值或运行影响。 -->
        <id property="sourceId" column="source_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="tenantId" column="tenant_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="sourceName" column="source_name"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="redisEndpoints" column="redis_endpoints"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="redisNamespace" column="redis_namespace"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="keyPattern" column="key_pattern"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="authMode" column="auth_mode"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="credentialRef" column="credential_ref"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="bypassOnUnavailable" column="bypass_on_unavailable"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="enabled" column="enabled"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createTime" column="create_time"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 配置项 sql id=BaseColumns：说明该配置的用途、默认值或运行影响。 -->
    <sql id="BaseColumns">
        source_id,
        tenant_id,
        source_name,
        redis_endpoints,
        redis_namespace,
        key_pattern,
        auth_mode,
        credential_ref,
        bypass_on_unavailable,
        enabled,
        create_time,
        update_time
    </sql>

    <!-- 配置项 insert id=upsert：说明该配置的用途、默认值或运行影响。 -->
    <insert id="upsert" parameterType="com.company.governance.infrastructure.persistence.entity.RedisRuleSourceRecord">
        INSERT INTO redis_rule_source (
            source_id,
            tenant_id,
            source_name,
            redis_endpoints,
            redis_namespace,
            key_pattern,
            auth_mode,
            credential_ref,
            bypass_on_unavailable,
            enabled,
            create_time,
            update_time
        ) VALUES (
            #{sourceId},
            #{tenantId},
            #{sourceName},
            #{redisEndpoints},
            #{redisNamespace},
            #{keyPattern},
            #{authMode},
            #{credentialRef},
            #{bypassOnUnavailable},
            #{enabled},
            #{createTime},
            #{updateTime}
        )
        ON DUPLICATE KEY UPDATE
            source_name = VALUES(source_name),
            redis_endpoints = VALUES(redis_endpoints),
            redis_namespace = VALUES(redis_namespace),
            key_pattern = VALUES(key_pattern),
            auth_mode = VALUES(auth_mode),
            credential_ref = VALUES(credential_ref),
            bypass_on_unavailable = VALUES(bypass_on_unavailable),
            enabled = VALUES(enabled),
            update_time = VALUES(update_time)
    </insert>

    <!-- 配置项 select id=selectByTenantIdAndSourceId：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectByTenantIdAndSourceId" resultMap="RedisRuleSourceResultMap">
        SELECT
        <!-- 配置项 include：说明该配置的用途、默认值或运行影响。 -->
        <include refid="BaseColumns"/>
        FROM redis_rule_source
        WHERE tenant_id = #{tenantId}
          AND source_id = #{sourceId}
    </select>

    <!-- 配置项 select id=selectByTenantId：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectByTenantId" resultMap="RedisRuleSourceResultMap">
        SELECT
        <!-- 配置项 include：说明该配置的用途、默认值或运行影响。 -->
        <include refid="BaseColumns"/>
        FROM redis_rule_source
        WHERE tenant_id = #{tenantId}
        ORDER BY source_name ASC, update_time DESC
    </select>
</mapper>
