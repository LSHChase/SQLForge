<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.governance.infrastructure.persistence.mapper.ExecutionResultMapper">

    <resultMap id="ExecutionResultResultMap" type="com.company.governance.domain.trace.entity.ExecutionResultRecord">
        <id property="resultId" column="result_id"/>
        <result property="configSnapshotId" column="config_snapshot_id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="serviceCode" column="service_code"/>
        <result property="taskId" column="task_id"/>
        <result property="taskType" column="task_type"/>
        <result property="resultStatus" column="result_status"/>
        <result property="traceId" column="trace_id"/>
        <result property="requestId" column="request_id"/>
        <result property="sagaId" column="saga_id"/>
        <result property="resultSummary" column="result_summary"/>
        <result property="resultPayload" column="result_payload"/>
        <result property="errorCode" column="error_code"/>
        <result property="errorMessage" column="error_message"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="BaseColumns">
        result_id,
        config_snapshot_id,
        tenant_id,
        service_code,
        task_id,
        task_type,
        result_status,
        trace_id,
        request_id,
        saga_id,
        result_summary,
        result_payload,
        error_code,
        error_message,
        started_at,
        finished_at,
        create_time
    </sql>

    <select id="selectById" resultMap="ExecutionResultResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM execution_result
        WHERE result_id = #{resultId}
    </select>

    <insert id="insert" parameterType="com.company.governance.domain.trace.entity.ExecutionResultRecord">
        INSERT INTO execution_result (
            result_id,
            config_snapshot_id,
            tenant_id,
            service_code,
            task_id,
            task_type,
            result_status,
            trace_id,
            request_id,
            saga_id,
            result_summary,
            result_payload,
            error_code,
            error_message,
            started_at,
            finished_at,
            create_time
        ) VALUES (
            #{resultId},
            #{configSnapshotId},
            #{tenantId},
            #{serviceCode},
            #{taskId},
            #{taskType},
            #{resultStatus},
            #{traceId},
            #{requestId},
            #{sagaId},
            #{resultSummary},
            #{resultPayload},
            #{errorCode},
            #{errorMessage},
            #{startedAt},
            #{finishedAt},
            #{createTime}
        )
    </insert>
</mapper>
