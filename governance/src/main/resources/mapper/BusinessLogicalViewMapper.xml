<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.governance.infrastructure.persistence.mapper.BusinessLogicalViewMapper">

    <resultMap id="BusinessLogicalViewResultMap" type="com.company.governance.domain.logicalview.entity.BusinessLogicalView">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="viewCode" column="view_code"/>
        <result property="viewName" column="view_name"/>
        <result property="datasourceCode" column="datasource_code"/>
        <result property="subjectArea" column="subject_area"/>
        <result property="ownerUser" column="owner_user"/>
        <result property="freshnessStatus" column="freshness_status"/>
        <result property="slaStatus" column="sla_status"/>
        <result property="queryable" column="queryable"/>
        <result property="latestRefreshTime" column="latest_refresh_time"/>
        <result property="description" column="description"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="BaseColumns">
        id,
        tenant_id,
        view_code,
        view_name,
        datasource_code,
        subject_area,
        owner_user,
        freshness_status,
        sla_status,
        queryable,
        latest_refresh_time,
        description,
        create_time,
        update_time
    </sql>

    <select id="selectByTenantAndDatasource" resultMap="BusinessLogicalViewResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM business_logical_view
        WHERE tenant_id = #{tenantId}
        <if test="datasourceCode != null and datasourceCode != ''">
            AND datasource_code = #{datasourceCode}
        </if>
        ORDER BY view_code ASC
    </select>

    <select id="selectByTenantAndViewCode" resultMap="BusinessLogicalViewResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM business_logical_view
        WHERE tenant_id = #{tenantId}
          AND view_code = #{viewCode}
    </select>
</mapper>
