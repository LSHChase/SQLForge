<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 配置项 mapper：说明该配置的用途、默认值或运行影响。 -->
<mapper namespace="com.company.governance.infrastructure.persistence.mapper.LogicalObjectMappingMapper">

    <!-- 配置项 resultMap id=LogicalObjectMappingResultMap：说明该配置的用途、默认值或运行影响。 -->
    <resultMap id="LogicalObjectMappingResultMap" type="com.company.governance.domain.logicalview.entity.LogicalObjectMapping">
        <!-- 配置项 id：说明该配置的用途、默认值或运行影响。 -->
        <id property="id" column="id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="tenantId" column="tenant_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="logicalViewId" column="logical_view_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="targetObjectType" column="target_object_type"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="targetObjectKey" column="target_object_key"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="targetObjectName" column="target_object_name"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="mappingRole" column="mapping_role"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createTime" column="create_time"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 配置项 select id=selectByTenantAndLogicalViewId：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectByTenantAndLogicalViewId" resultMap="LogicalObjectMappingResultMap">
        SELECT
            id,
            tenant_id,
            logical_view_id,
            target_object_type,
            target_object_key,
            target_object_name,
            mapping_role,
            create_time,
            update_time
        FROM logical_object_mapping
        WHERE tenant_id = #{tenantId}
          AND logical_view_id = #{logicalViewId}
        ORDER BY target_object_type ASC, target_object_key ASC
    </select>
</mapper>
