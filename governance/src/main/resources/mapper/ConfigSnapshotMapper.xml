<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 配置项 mapper：说明该配置的用途、默认值或运行影响。 -->
<mapper namespace="com.company.governance.infrastructure.persistence.mapper.ConfigSnapshotMapper">

    <!-- 配置项 resultMap id=ConfigSnapshotResultMap：说明该配置的用途、默认值或运行影响。 -->
    <resultMap id="ConfigSnapshotResultMap" type="com.company.governance.domain.trace.entity.ConfigSnapshotRecord">
        <!-- 配置项 id：说明该配置的用途、默认值或运行影响。 -->
        <id property="configSnapshotId" column="config_snapshot_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="tenantId" column="tenant_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="serviceCode" column="service_code"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="sourceConfigType" column="source_config_type"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="sourceConfigId" column="source_config_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="sourceVersion" column="source_version"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="snapshotStatus" column="snapshot_status"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="snapshotReason" column="snapshot_reason"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="traceId" column="trace_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="requestId" column="request_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="sagaId" column="saga_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="snapshotPayload" column="snapshot_payload"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createdBy" column="created_by"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 配置项 sql id=BaseColumns：说明该配置的用途、默认值或运行影响。 -->
    <sql id="BaseColumns">
        config_snapshot_id,
        tenant_id,
        service_code,
        source_config_type,
        source_config_id,
        source_version,
        snapshot_status,
        snapshot_reason,
        trace_id,
        request_id,
        saga_id,
        snapshot_payload,
        created_by,
        create_time
    </sql>

    <!-- 配置项 select id=selectById：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectById" resultMap="ConfigSnapshotResultMap">
        SELECT
        <!-- 配置项 include：说明该配置的用途、默认值或运行影响。 -->
        <include refid="BaseColumns"/>
        FROM config_snapshot
        WHERE config_snapshot_id = #{configSnapshotId}
    </select>

    <!-- 配置项 insert id=insert：说明该配置的用途、默认值或运行影响。 -->
    <insert id="insert" parameterType="com.company.governance.domain.trace.entity.ConfigSnapshotRecord">
        INSERT INTO config_snapshot (
            config_snapshot_id,
            tenant_id,
            service_code,
            source_config_type,
            source_config_id,
            source_version,
            snapshot_status,
            snapshot_reason,
            trace_id,
            request_id,
            saga_id,
            snapshot_payload,
            created_by,
            create_time
        ) VALUES (
            #{configSnapshotId},
            #{tenantId},
            #{serviceCode},
            #{sourceConfigType},
            #{sourceConfigId},
            #{sourceVersion},
            #{snapshotStatus},
            #{snapshotReason},
            #{traceId},
            #{requestId},
            #{sagaId},
            #{snapshotPayload},
            #{createdBy},
            #{createTime}
        )
    </insert>
</mapper>
