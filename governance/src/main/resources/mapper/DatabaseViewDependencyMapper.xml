<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 配置项 mapper：说明该配置的用途、默认值或运行影响。 -->
<mapper namespace="com.company.governance.infrastructure.persistence.mapper.DatabaseViewDependencyMapper">

    <!-- 配置项 resultMap id=DatabaseViewDependencyResultMap：说明该配置的用途、默认值或运行影响。 -->
    <resultMap id="DatabaseViewDependencyResultMap" type="com.company.governance.domain.dbview.entity.DatabaseViewDependency">
        <!-- 配置项 id：说明该配置的用途、默认值或运行影响。 -->
        <id property="id" column="id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="tenantId" column="tenant_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="dbViewId" column="db_view_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="dependencyObjectType" column="dependency_object_type"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="dependencyObjectKey" column="dependency_object_key"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="dependencyObjectName" column="dependency_object_name"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createTime" column="create_time"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 配置项 select id=selectByTenantAndDbViewId：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectByTenantAndDbViewId" resultMap="DatabaseViewDependencyResultMap">
        SELECT
            id,
            tenant_id,
            db_view_id,
            dependency_object_type,
            dependency_object_key,
            dependency_object_name,
            create_time,
            update_time
        FROM database_view_dependency
        WHERE tenant_id = #{tenantId}
          AND db_view_id = #{dbViewId}
        ORDER BY dependency_object_type ASC, dependency_object_key ASC
    </select>
</mapper>
