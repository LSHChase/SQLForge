<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 配置项 mapper：说明该配置的用途、默认值或运行影响。 -->
<mapper namespace="com.company.governance.infrastructure.persistence.mapper.JdbcDriverArtifactMapper">

    <!-- 配置项 resultMap id=JdbcDriverArtifactResultMap：说明该配置的用途、默认值或运行影响。 -->
    <resultMap id="JdbcDriverArtifactResultMap" type="com.company.governance.infrastructure.persistence.entity.JdbcDriverArtifactRecord">
        <!-- 配置项 id：说明该配置的用途、默认值或运行影响。 -->
        <id property="artifactId" column="artifact_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="tenantId" column="tenant_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="engineType" column="engine_type"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="driverClassName" column="driver_class_name"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="versionLabel" column="version_label"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="originalFileName" column="original_file_name"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="sizeBytes" column="size_bytes"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="sha256" column="sha256"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="relativePath" column="relative_path"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="status" column="status"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="uploadedBy" column="uploaded_by"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createTime" column="create_time"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 配置项 sql id=BaseColumns：说明该配置的用途、默认值或运行影响。 -->
    <sql id="BaseColumns">
        artifact_id,
        tenant_id,
        engine_type,
        driver_class_name,
        version_label,
        original_file_name,
        size_bytes,
        sha256,
        relative_path,
        status,
        uploaded_by,
        create_time,
        update_time
    </sql>

    <!-- 配置项 insert id=insert：说明该配置的用途、默认值或运行影响。 -->
    <insert id="insert" parameterType="com.company.governance.infrastructure.persistence.entity.JdbcDriverArtifactRecord">
        INSERT INTO jdbc_driver_artifact (
            artifact_id,
            tenant_id,
            engine_type,
            driver_class_name,
            version_label,
            original_file_name,
            size_bytes,
            sha256,
            relative_path,
            status,
            uploaded_by,
            create_time,
            update_time
        ) VALUES (
            #{artifactId},
            #{tenantId},
            #{engineType},
            #{driverClassName},
            #{versionLabel},
            #{originalFileName},
            #{sizeBytes},
            #{sha256},
            #{relativePath},
            #{status},
            #{uploadedBy},
            #{createTime},
            #{updateTime}
        )
    </insert>

    <!-- 配置项 select id=selectByTenantIdAndArtifactId：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectByTenantIdAndArtifactId" resultMap="JdbcDriverArtifactResultMap">
        SELECT
        <!-- 配置项 include：说明该配置的用途、默认值或运行影响。 -->
        <include refid="BaseColumns"/>
        FROM jdbc_driver_artifact
        WHERE tenant_id = #{tenantId}
          AND artifact_id = #{artifactId}
    </select>

    <!-- 配置项 select id=selectByTenantId：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectByTenantId" resultMap="JdbcDriverArtifactResultMap">
        SELECT
        <!-- 配置项 include：说明该配置的用途、默认值或运行影响。 -->
        <include refid="BaseColumns"/>
        FROM jdbc_driver_artifact
        WHERE tenant_id = #{tenantId}
        ORDER BY create_time DESC
    </select>
</mapper>
