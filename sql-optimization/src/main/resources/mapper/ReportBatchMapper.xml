<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 配置项 mapper：说明该配置的用途、默认值或运行影响。 -->
<mapper namespace="com.company.sqloptimization.infrastructure.persistence.mapper.ReportBatchMapper">

    <!-- 配置项 resultMap id=ReportBatchRecordMap：说明该配置的用途、默认值或运行影响。 -->
    <resultMap id="ReportBatchRecordMap" type="com.company.sqloptimization.infrastructure.persistence.entity.ReportBatchRecord">
        <!-- 配置项 id：说明该配置的用途、默认值或运行影响。 -->
        <id property="batchId" column="batch_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="tenantId" column="tenant_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="batchName" column="batch_name"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="fileType" column="file_type"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="reportCodeField" column="report_code_field"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="datasourceCode" column="datasource_code"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="stage" column="stage"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="priority" column="priority"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="parserMode" column="parser_mode"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="sourceType" column="source_type"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="status" column="status"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="totalReports" column="total_reports"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="resolvedReports" column="resolved_reports"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="failedReports" column="failed_reports"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="statusHistoryJson" column="status_history_json"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createdBy" column="created_by"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createdAt" column="created_at"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 配置项 sql id=BaseColumns：说明该配置的用途、默认值或运行影响。 -->
    <sql id="BaseColumns">
        batch_id, tenant_id, batch_name, file_type, report_code_field, datasource_code, stage, priority, parser_mode,
        source_type, status, total_reports, resolved_reports, failed_reports, status_history_json,
        created_by, created_at, updated_at
    </sql>

    <!-- 配置项 select id=selectByBatchId：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectByBatchId" resultMap="ReportBatchRecordMap">
        SELECT <include refid="BaseColumns"/>
        FROM report_batch
        WHERE batch_id = #{batchId}
    </select>

    <!-- 配置项 select id=selectAll：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectAll" resultMap="ReportBatchRecordMap">
        SELECT <include refid="BaseColumns"/>
        FROM report_batch
        ORDER BY created_at DESC, batch_id DESC
    </select>

    <!-- 配置项 select id=selectPageByTenantId：按租户分页读取报表批次摘要，避免列表页加载明细。 -->
    <select id="selectPageByTenantId" resultMap="ReportBatchRecordMap">
        SELECT <include refid="BaseColumns"/>
        FROM report_batch
        WHERE tenant_id = #{tenantId}
        ORDER BY created_at DESC, batch_id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 配置项 select id=countByTenantId：统计租户报表批次数。 -->
    <select id="countByTenantId" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM report_batch
        WHERE tenant_id = #{tenantId}
    </select>

    <!-- 配置项 insert id=insert：说明该配置的用途、默认值或运行影响。 -->
    <insert id="insert" parameterType="com.company.sqloptimization.infrastructure.persistence.entity.ReportBatchRecord">
        INSERT INTO report_batch (
            batch_id, tenant_id, batch_name, file_type, report_code_field, datasource_code, stage, priority, parser_mode,
            source_type, status, total_reports, resolved_reports, failed_reports, status_history_json,
            created_by, created_at, updated_at
        ) VALUES (
            #{batchId}, #{tenantId}, #{batchName}, #{fileType}, #{reportCodeField}, #{datasourceCode}, #{stage}, #{priority}, #{parserMode},
            #{sourceType}, #{status}, #{totalReports}, #{resolvedReports}, #{failedReports}, #{statusHistoryJson},
            #{createdBy}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <!-- 配置项 update id=update：说明该配置的用途、默认值或运行影响。 -->
    <update id="update" parameterType="com.company.sqloptimization.infrastructure.persistence.entity.ReportBatchRecord">
        UPDATE report_batch
        SET tenant_id = #{tenantId},
            batch_name = #{batchName},
            file_type = #{fileType},
            report_code_field = #{reportCodeField},
            datasource_code = #{datasourceCode},
            stage = #{stage},
            priority = #{priority},
            parser_mode = #{parserMode},
            source_type = #{sourceType},
            status = #{status},
            total_reports = #{totalReports},
            resolved_reports = #{resolvedReports},
            failed_reports = #{failedReports},
            status_history_json = #{statusHistoryJson},
            created_by = #{createdBy},
            created_at = #{createdAt},
            updated_at = #{updatedAt}
        WHERE batch_id = #{batchId}
    </update>
</mapper>
