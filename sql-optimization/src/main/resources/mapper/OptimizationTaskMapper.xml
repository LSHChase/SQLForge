        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="requestedSuggestionTypesJson" column="requested_suggestion_types_json"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="taskContextJson" column="task_context_json"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="status" column="status"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="currentPhase" column="current_phase"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
