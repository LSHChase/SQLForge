        <result property="submittedAt" column="submitted_at"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="startedAt" column="started_at"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="finishedAt" column="finished_at"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="createTime" column="create_time"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 配置项 sql id=BaseColumns：说明该配置的用途、默认值或运行影响。 -->
    <sql id="BaseColumns">
        task_id,
        tenant_id,
        task_type,
        sql_text,
        sql_fingerprint,
        datasource_type,
        priority,
        parse_depth,
        callback_url,
        requested_suggestion_types_json,
        task_context_json,
        status,
        current_phase,
        progress_percent,
        summary,
        suggestion_payload_json,
        error_code,
        error_message,
        error_suggested_action,
        error_retryable,
        failed_phase,
        error_risks_json,
        status_history_json,
        submitted_at,
        started_at,
        finished_at,
        create_time,
        update_time
    </sql>

    <!-- 配置项 select id=selectByTaskId：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectByTaskId" resultMap="OptimizationTaskRecordMap">
        SELECT
        <!-- 配置项 include：说明该配置的用途、默认值或运行影响。 -->
        <include refid="BaseColumns"/>
        FROM optimization_task
        WHERE task_id = #{taskId}
    </select>

    <!-- 配置项 select id=selectQueuedTasksSubmittedBefore：说明该配置的用途、默认值或运行影响。 -->
    <select id="selectQueuedTasksSubmittedBefore" resultMap="OptimizationTaskRecordMap">
        SELECT
        <!-- 配置项 include：说明该配置的用途、默认值或运行影响。 -->
        <include refid="BaseColumns"/>
        FROM optimization_task
        WHERE status = 'QUEUED'
          AND submitted_at &lt;= #{cutoff}
        ORDER BY submitted_at ASC
    </select>

    <!-- 配置项 insert id=insert：说明该配置的用途、默认值或运行影响。 -->
    <insert id="insert" parameterType="com.company.sqloptimization.infrastructure.persistence.entity.OptimizationTaskRecord">
        INSERT INTO optimization_task (
            task_id,
            tenant_id,
            task_type,
            sql_text,
            sql_fingerprint,
            datasource_type,
            priority,
            parse_depth,
            callback_url,
            requested_suggestion_types_json,
            task_context_json,
            status,
            current_phase,
            progress_percent,
            summary,
            suggestion_payload_json,
            error_code,
            error_message,
            error_suggested_action,
            error_retryable,
            failed_phase,
            error_risks_json,
            status_history_json,
            submitted_at,
            started_at,
            finished_at
        ) VALUES (
            #{taskId},
            #{tenantId},
            #{taskType},
            #{sqlText},
            #{sqlFingerprint},
            #{datasourceType},
            #{priority},
            #{parseDepth},
            #{callbackUrl},
            #{requestedSuggestionTypesJson},
            #{taskContextJson},
            #{status},
            #{currentPhase},
            #{progressPercent},
            #{summary},
            #{suggestionPayloadJson},
            #{errorCode},
            #{errorMessage},
            #{errorSuggestedAction},
            #{errorRetryable},
            #{failedPhase},
            #{errorRisksJson},
            #{statusHistoryJson},
            #{submittedAt},
            #{startedAt},
            #{finishedAt}
        )
    </insert>

    <!-- 配置项 update id=update：说明该配置的用途、默认值或运行影响。 -->
    <update id="update" parameterType="com.company.sqloptimization.infrastructure.persistence.entity.OptimizationTaskRecord">
        UPDATE optimization_task
        SET tenant_id = #{tenantId},
            task_type = #{taskType},
            sql_text = #{sqlText},
            sql_fingerprint = #{sqlFingerprint},
            datasource_type = #{datasourceType},
            priority = #{priority},
            parse_depth = #{parseDepth},
            callback_url = #{callbackUrl},
            requested_suggestion_types_json = #{requestedSuggestionTypesJson},
            task_context_json = #{taskContextJson},
            status = #{status},
            current_phase = #{currentPhase},
            progress_percent = #{progressPercent},
            summary = #{summary},
            suggestion_payload_json = #{suggestionPayloadJson},
            error_code = #{errorCode},
            error_message = #{errorMessage},
            error_suggested_action = #{errorSuggestedAction},
            error_retryable = #{errorRetryable},
            failed_phase = #{failedPhase},
            error_risks_json = #{errorRisksJson},
            status_history_json = #{statusHistoryJson},
            submitted_at = #{submittedAt},
            started_at = #{startedAt},
            finished_at = #{finishedAt}
        WHERE task_id = #{taskId}
    </update>
</mapper>
