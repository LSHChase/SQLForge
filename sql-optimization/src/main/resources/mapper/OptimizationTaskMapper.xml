        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="suggestionPayloadJson" column="suggestion_payload_json"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="errorCode" column="error_code"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="errorMessage" column="error_message"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="errorSuggestedAction" column="error_suggested_action"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="errorRetryable" column="error_retryable"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
        <result property="failedPhase" column="failed_phase"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
