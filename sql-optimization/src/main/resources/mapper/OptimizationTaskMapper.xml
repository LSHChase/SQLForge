<mapper namespace="com.company.sqloptimization.infrastructure.persistence.mapper.OptimizationTaskMapper">

    <!-- 配置项 resultMap id=OptimizationTaskRecordMap：说明该配置的用途、默认值或运行影响。 -->
    <resultMap id="OptimizationTaskRecordMap" type="com.company.sqloptimization.infrastructure.persistence.entity.OptimizationTaskRecord">
        <!-- 配置项 id：说明该配置的用途、默认值或运行影响。 -->
        <id property="taskId" column="task_id"/>
        <!-- 配置项 result：说明该配置的用途、默认值或运行影响。 -->
